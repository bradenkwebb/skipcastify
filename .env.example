DATA_DIR=data
SUBSCRIPTIONS=upstream.opml
SERVER_BASE_URL=https://your-tailscale-host.ts.net
FEED_USERNAME=skipcastify
FEED_PASSWORD=change-me
EPISODE_TOKEN=change-me
EPISODE_LIMIT=5
ENABLE_PROCESSING=false
PROCESS_SLUGS=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=gemma4:e2b
STORAGE_HIGH_WATER_GB=75
STORAGE_LOW_WATER_GB=50

# Flask bind address. Loopback is right when tailscale serve proxies it.
BIND_HOST=127.0.0.1
BIND_PORT=5000

# ntfy topic for pipeline alerts; empty disables them.
NTFY_TOPIC=

# Cloudflare R2 publishing — see docs/r2-publishing.md.
# PUBLIC_PATH_SECRET is a fresh `secrets.token_urlsafe(32)`; never reuse
# EPISODE_TOKEN for it.
PUBLISH_TO_R2=false
PUBLIC_BASE_URL=https://pods.example.com
PUBLIC_PATH_SECRET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=skipcastify
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RETENTION_DAYS=14
R2_CAP_GB=7
R2_FALLBACK_HOURS=6

# Consecutive R2 upload/delete failures in one run before alerting.
R2_MAX_FAILURES_PER_RUN=3

# Class A circuit breaker. A normal run spends single digits; crossing either
# limit disables publishing until it is cleared by hand with
#   uv run python -m skipcastify.tools.r2ctl clear-breaker
R2_MAX_CLASS_A_PER_RUN=200
R2_MAX_CLASS_A_PER_DAY=2000

# How often to reconcile the manifest against the bucket. This is the only
# thing that calls ListObjectsV2, so it is also the only knob that can make
# LIST expensive.
R2_RECONCILE_HOURS=24
